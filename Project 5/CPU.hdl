// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    And(a=instruction[15] , b=instruction[5] , out=Aload1 );
    And(a=instruction[15] , b=instruction[4] , out=Dload );
    And(a=instruction[15] , b=instruction[3] , out=writeM );
    Not(in=instruction[15] , out=Nopcode );
    Or(a=Aload1 , b=Nopcode , out=Aload );
    Mux16(a=instruction , b=ALUout , sel=Aload1 , out=MuxA );
    ARegister(in=MuxA , load=Aload , out=Aout , out[0..14]=addressM );
    Mux16(a=Aout , b=inM , sel=instruction[12] , out=yALU );
    ALU(x=Dout , y=yALU , zx=instruction[11] , nx=instruction[10] , zy=instruction[9] , ny=instruction[8] , f=instruction[7] , no=instruction[6] , out=outM , out=ALUout , zr=zr , ng=ng );
    DRegister(in=ALUout , load=Dload , out=Dout );

    //jump logic
    Not(in=instruction[0] , out=Nj3 );
    Not(in=instruction[1] , out=Nj2 );
    Not(in=instruction[2] , out=Nj1 );
    And(a=Nj1 , b=Nj2 , out=Nj1andNj2 );
    And(a=Nj1andNj2 , b=instruction[0] , out=JGT );
    And(a=Nj1 , b=Nj3 , out=Nj1andNj3 );
    And(a=Nj1andNj3 , b=instruction[1] , out=JEQ );
    And(a=instruction[1] , b=instruction[0] , out=j2andj3 );
    And(a=j2andj3 , b=Nj1 , out=JGE );
    And(a=Nj2 , b=Nj3 , out=Nj2andNj3 );
    And(a=Nj2andNj3 , b=instruction[2] , out=JLT );
    And(a=instruction[2] , b=instruction[0] , out=j1andj3 );
    And(a=j1andj3 , b=Nj2 , out=JNE );
    And(a=instruction[2] , b=instruction[1] , out=j1andj2 );
    And(a=j1andj2 , b=Nj3 , out=JLE );
    And(a=j1andj2 , b=j2andj3 , out=YesJump7 );
    Or(a=zr , b=ng , out=zrORng );
    Not(in=zrORng , out=pos );
    And(a=JGT , b=pos , out=YesJump1 );
    And(a=JEQ , b=zr , out=YesJump2 );
    Or(a=zr , b=pos , out=zrORpos );
    And(a=JGE , b=zrORpos , out=YesJump3 );
    And(a=JLT , b=ng , out=YesJump4 );
    Not(in=zr , out=Nzr );
    And(a=JNE , b=Nzr , out=YesJump5 );
    And(a=JLE , b=zrORng , out=YesJump6 );
    Or(a=YesJump1 , b=YesJump2 , out=jtemp1 );
    Or(a=YesJump3 , b=YesJump4 , out=jtemp2 );
    Or(a=jtemp1 , b=jtemp2 , out=jtemp3 );
    Or(a=YesJump5 , b=YesJump6 , out=jtemp4 );
    Or(a=jtemp3 , b=jtemp4 , out=jtemp5 );
    Or(a=jtemp5 , b=YesJump7 , out=MaybeJump );
    And(a=MaybeJump , b=instruction[15] , out=YesJump );

    PC(in=Aout , load=YesJump , inc=true , reset=reset , out[0..14]=pc );
}