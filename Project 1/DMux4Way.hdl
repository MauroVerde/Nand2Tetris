// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[0] , out=Notsel0 );
    Not(in=sel[1] , out=Notsel1 );
    And(a=Notsel0 , b=Notsel1 , out=aTrue );
    And(a=sel[0] , b=Notsel1 , out=bTrue );
    And(a=Notsel0 , b=sel[1] , out=cTrue );
    And(a=sel[0] , b=sel[1] , out=dTrue );
    And(a=in , b=aTrue , out=a );
    And(a=in , b=bTrue , out=b );
    And(a=in , b=cTrue , out=c );
    And(a=in , b=dTrue , out=d );
}